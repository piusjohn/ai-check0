# ============================================================================
# aicheck0 — Environment Configuration (AgentRouter.org / OpenAI Compatible)
# Copy this file to `.env` and paste your actual key:
#   cp .env.example .env
# ============================================================================

# 1. Free / OpenAI-Compatible API Key from https://agentrouter.org
AGENTROUTER_API_KEY=ar-your-agentrouter-api-key-here

# 2. AgentRouter Base URL (OpenAI SDK compatible endpoint)
AGENTROUTER_BASE_URL=https://api.agentrouter.org/v1

# 3. Default AI Model & Timeout
AI_MODEL=deepseek-chat
AI_TIMEOUT=30

# 4. Optional fallback alias for tools expecting OPENAI_API_KEY
OPENAI_API_KEY=ar-your-agentrouter-api-key-here
